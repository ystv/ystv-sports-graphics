{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx",
    ]
}